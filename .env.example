# Cloud RAG System Environment Variables
# Copy this file to .env and fill in your actual credentials

# Upstash Vector Database Configuration
UPSTASH_VECTOR_REST_URL="https://your-upstash-url"
UPSTASH_VECTOR_REST_TOKEN="your-upstash-token"
# Groq Cloud API Configuration
GROQ_API_KEY="your-groq-api-key"

# Optional: Database Configuration (if using custom settings)
# UPSTASH_VECTOR_DATABASE_NAME=rag-food-advanced-yourname
